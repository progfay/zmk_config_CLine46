#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    behaviors {
        // arrow keys on layer 1 (Arrow):
        //   - without LGUI: strip ctrl -> plain arrow (&ctrl_off)
        //   - with LGUI:    keep ctrl & LGUI -> ctrl + LGUI + arrow (&kp)
        arw_left: arw_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ctrl_off LEFT>, <&kp LEFT>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
            keep-mods = <(MOD_LGUI|MOD_RGUI)>;
        };
        arw_down: arw_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ctrl_off DOWN>, <&kp DOWN>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
            keep-mods = <(MOD_LGUI|MOD_RGUI)>;
        };
        arw_up: arw_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ctrl_off UP>, <&kp UP>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
            keep-mods = <(MOD_LGUI|MOD_RGUI)>;
        };
        arw_right: arw_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ctrl_off RIGHT>, <&kp RIGHT>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
            keep-mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        // tap: the given key / hold: RSHIFT + layer 2
        lang1_sh2: lang1_sh2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&rsft_l2>, <&kp>;
        };
    };

    macros {
        // release LCTRL, send the given key, then re-press LCTRL.
        // used on layer 1 (Arrow) so that arrow keys are sent WITHOUT ctrl,
        // while ctrl stays held for every other key.
        ctrl_off: ctrl_off {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
                = <&macro_release &kp LCTRL>
                , <&macro_param_1to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_press &kp LCTRL>
                ;
            label = "CTRL_OFF";
        };

        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
            label = "LAYER_MOD";
        };

        // hold RSHIFT while activating layer 2
        rsft_l2: rsft_l2 {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo 2 &kp RSHIFT>
                , <&macro_pause_for_release>
                , <&macro_release &kp RSHIFT &mo 2>
                ;
            label = "RSFT_L2";
        };

        // press LANG2 and LGUI together
        lang2_gui: lang2_gui {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LANG2>
                , <&macro_press &kp LGUI>
                , <&macro_pause_for_release>
                , <&macro_release &kp LGUI>
                ;
            label = "LANG2_GUI";
        };
    };

    combos {
        compatible = "zmk,combos";

        // K + L -> backspace
        combo_backspace {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp BACKSPACE>;
            layers = <0>;
        };

        // K + L while holding &mo 3 (SCROLL layer) -> delete
        combo_delete {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp DELETE>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB      &kp Q  &kp W   &kp E   &kp R       &kp T                                 &kp Y               &kp U       &kp I      &kp O        &kp P       &kp BACKSPACE
&lm 1 LCTRL  &kp A  &kp S   &kp D   &kp F       &kp G                                 &kp H               &kp J       &kp K      &lt 3 L      &kp SEMI    &kp SINGLE_QUOTE
&kp LSHIFT   &kp Z  &kp X   &kp C   &kp V       &kp B                                 &kp N               &kp M       &kp COMMA  &kp DOT      &kp SLASH   &none
             &mo 3  &trans  &trans  &lm 1 LALT  &lang2_gui  &lt 2 SPACE  &lt 1 ENTER  &lang1_sh2 0 LANG1                         &kp MINUS    &kp EQUAL
            >;
        };


        layer_1 {
            display-name = "Arrow";
            bindings = <
&trans     &trans  &trans  &trans  &trans    &trans                     &trans          &trans          &trans          &trans           &trans  &trans
&kp LCTRL  &trans  &trans  &trans  &trans    &trans                     &arw_left  &arw_down  &arw_up  &arw_right  &trans  &trans
&trans     &trans  &trans  &trans  &trans    &trans                     &trans          &trans          &trans          &trans           &trans  &trans
           &trans  &trans  &trans  &kp LALT  &trans  &trans  &kp SPACE  &trans                                          &trans           &trans
            >;
        };


        layer_2 {
            display-name = "Num";
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4     &kp N5                     &kp N6    &kp N7          &kp N8        &kp N9  &kp N0  &kp BACKSPACE
&trans     &kp N4  &kp N5  &kp N6  &mkp LCLK  &mkp RCLK                  &trans    &trans          &trans        &trans  &trans  &kp BSLH
&trans     &kp N7  &kp N8  &kp N9  &trans     &kp LBKT                   &kp RBKT  &msc SCRL_DOWN  &msc SCRL_UP  &trans  &trans  &trans
           &trans  &kp N0  &trans  &trans     &trans     &trans  &trans  &trans                                  &trans  &trans
            >;
        };


        layer_3 {
            display-name = "Scroll";
            bindings = <
&kp ESC  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &bt BT_CLR   &trans   &trans   &trans   &kp F17  &kp DELETE
&trans   &trans        &trans        &kp F19       &trans        &trans                        &kp F13      &kp F14  &kp F15  &kp F16  &trans   &trans
&trans   &trans        &trans        &trans        &trans        &trans                        &kp F18      &trans   &trans   &trans   &trans   &trans
         &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans                         &trans   &trans
            >;
        };


        // unused layer (layer_4, 5, 6 are available)
        /*
        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans
            >;
        };
        */
    };
};
