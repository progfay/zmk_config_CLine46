#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&msc_input_listener {
    // 速度値(MOVE_UP/DOWN)は大きいまま滑らかさを確保し、
    // ホイール出力を track-remainders 付きで割って移動量だけ小さくする
    input-processors = <&zip_scroll_smooth 1 16>;
};

&msc {
    acceleration-exponent = <1>;     // 0=等速 / 1=等加速度。短押しを控えめにする
    time-to-max-speed-ms = <400>;    // 最高速まで 400ms かけて加速(既定300)
};

/ {
    input_processors {
        // INPUT_REL_WHEEL の端数を切り捨てず累積して滑らかに割る scaler
        zip_scroll_smooth: zip_scroll_smooth {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
            track-remainders;
        };
    };

    behaviors {
        // tap: the given key / hold: RSHIFT + layer 1
        lang1_sh2: lang1_sh2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&rsft_l2>, <&kp>;
        };

        // hjkl morph into arrows on CTRL/ALT (ctrl masked, alt kept).
        // GUI disables the morph, so gui+ctrl+h stays ⌘⌃h,
        // except alt+gui+h / shift+gui+h which morph into alt+gui+← / shift+gui+← (via h_gui).
        h_morph: h_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&h_arrow>, <&h_gui>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
        h_gui: h_gui {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp H>, <&kp LEFT>;
            mods = <(MOD_LALT|MOD_LSFT)>;
            keep-mods = <(MOD_LALT|MOD_LSFT)>;
        };
        h_arrow: h_arrow {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp H>, <&kp LEFT>;
            mods = <(MOD_LCTL|MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };
        j_morph: j_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&j_arrow>, <&j_gui>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
        j_gui: j_gui {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp J>, <&kp DOWN>;
            mods = <(MOD_LALT|MOD_LSFT)>;
            keep-mods = <(MOD_LALT|MOD_LSFT)>;
        };
        j_arrow: j_arrow {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp J>, <&kp DOWN>;
            mods = <(MOD_LCTL|MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };
        k_morph: k_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&k_arrow>, <&k_gui>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
        k_gui: k_gui {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp K>, <&kp UP>;
            mods = <(MOD_LALT|MOD_LSFT)>;
            keep-mods = <(MOD_LALT|MOD_LSFT)>;
        };
        k_arrow: k_arrow {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp K>, <&kp UP>;
            mods = <(MOD_LCTL|MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };
        l_morph: l_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&l_arrow>, <&l_gui>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
        l_gui: l_gui {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&lt 2 L>, <&kp RIGHT>;
            mods = <(MOD_LALT|MOD_LSFT)>;
            keep-mods = <(MOD_LALT|MOD_LSFT)>;
        };
        l_arrow: l_arrow {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&lt 2 L>, <&kp RIGHT>;
            mods = <(MOD_LCTL|MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        // RCLK, but while LGUI is held it morphs into LGUI+[
        rclk_morph: rclk_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mkp RCLK>, <&kp LBKT>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        // ENTER, but while LALT is held it morphs into SPACE
        // so &kp LALT + this key -> ⌥Space
        enter_morph: enter_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&lt 1 ENTER>, <&kp SPACE>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };
    };

    macros {
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
            label = "LAYER_MOD";
        };

        // hold RSHIFT while activating layer 1
        rsft_l2: rsft_l2 {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo 1 &kp RSHIFT>
                , <&macro_pause_for_release>
                , <&macro_release &kp RSHIFT &mo 1>
                ;
            label = "RSFT_L2";
        };

    };

    combos {
        compatible = "zmk,combos";

        // K + L -> backspace
        combo_backspace {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp BACKSPACE>;
            layers = <0>;
        };

        // K + L while holding &mo 2 (SCROLL layer) -> delete
        combo_delete {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp DELETE>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB     &kp Q  &kp W   &kp E   &kp R      &kp T                                      &kp Y               &kp U       &kp I      &kp O      &kp P       &kp BACKSPACE
&kp LCTRL   &kp A  &kp S   &kp D   &kp F      &kp G                                      &h_morph            &j_morph    &k_morph   &l_morph   &kp SEMI    &kp SINGLE_QUOTE
&kp LSHIFT  &kp Z  &kp X   &kp C   &kp V      &kp B                                      &kp N               &kp M       &kp COMMA  &kp DOT    &kp SLASH   &none
            &mo 2  &trans  &trans  &kp LALT   &mt LGUI LANG2  &lt 1 SPACE  &enter_morph  &lang1_sh2 0 LANG1                         &kp MINUS  &kp EQUAL
            >;
        };


        layer_1 {
            display-name = "Num";
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4     &kp N5                     &kp N6     &kp N7          &kp N8        &kp N9  &kp N0  &kp BACKSPACE
&trans     &kp N4  &kp N5  &kp N6  &mkp LCLK  &rclk_morph                &kp RBKT   &mkp LCLK       &mkp RCLK     &trans  &trans  &kp BSLH
&trans     &kp N7  &kp N8  &kp N9  &trans     &kp LBKT                   &kp RBKT   &msc MOVE_DOWN  &msc MOVE_UP  &trans  &trans  &trans
           &trans  &kp N0  &trans  &trans     &trans     &trans  &trans  &trans                                   &trans  &trans
            >;
        };


        layer_2 {
            display-name = "Scroll";
            bindings = <
&kp ESC  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &bt BT_CLR   &trans   &trans   &trans   &kp F17  &kp DELETE
&trans   &trans        &trans        &kp F19       &trans        &trans                        &kp F13      &kp F14  &kp F15  &kp F16  &trans   &trans
&trans   &trans        &trans        &trans        &mkp LCLK     &mkp RCLK                     &kp F18      &trans   &trans   &trans   &trans   &trans
         &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans                         &trans   &trans
            >;
        };


        // unused layer (layer_3, 4, 5, 6 are available)
        /*
        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans
            >;
        };
        */
    };
};
