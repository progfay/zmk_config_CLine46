#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    behaviors {
        // ctrl + h/j/k/l -> arrow keys.
        // mod-morph masks the triggering ctrl, but other held mods
        // (alt/gui/shift) pass through, e.g. alt+ctrl+j -> alt+DOWN.
        ctrl_left: ctrl_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp H>, <&kp LEFT>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        ctrl_down: ctrl_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp J>, <&kp DOWN>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        ctrl_up: ctrl_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp K>, <&kp UP>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        ctrl_right: ctrl_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp L>, <&kp RIGHT>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // LALT + ENTER -> alt+space (formerly SCROLL layer's LA(SPACE)).
        combo_alt_space {
            timeout-ms = <50>;
            key-positions = <39 42>;
            bindings = <&kp LA(SPACE)>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E  &kp R     &kp T                                &kp Y          &kp U       &kp I      &kp O        &kp P      &kp BACKSPACE
&kp LCTRL   &kp A  &kp S  &kp D  &kp F     &kp G                                &ctrl_left     &ctrl_down  &ctrl_up   &ctrl_right  &kp SEMI   &lt 3 SINGLE_QUOTE
&kp LSHIFT  &kp Z  &kp X  &kp C  &kp V     &kp B                                &kp N          &kp M       &kp COMMA  &kp DOT      &kp SLASH  &none
            &mo 3  &none  &mo 1  &kp LALT  &mt LGUI INT2  &kp SPACE  &kp ENTER  &mt LGUI INT1                         &kp MINUS    &kp EQUAL
            >;
        };


        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans                &trans                 &kp NUMBER_1  &kp NUMBER_2     &kp NUMBER_3     &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans  &trans                  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp NUMBER_4  &kp NUMBER_5     &kp NUMBER_6     &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NUMBER_7  &kp NUMBER_8     &kp KP_NUMBER_9  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                     &kp KP_NUMBER_0  &kp KP_DOT
            >;
        };


        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                        &trans  &trans
            >;
        };


        SCROLL {
            bindings = <
&trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &trans                  &trans   &trans   &trans   &trans   &kp F17  &studio_unlock
&trans  &trans  &trans  &kp F19       &trans        &trans                  &kp F13  &kp F14  &kp F15  &kp F16  &trans   &trans
&trans  &trans  &trans  &trans        &trans        &trans                  &kp F18  &trans   &trans   &trans   &trans   &trans
        &trans  &trans  &trans        &trans        &trans  &trans  &trans  &trans                     &trans   &trans
            >;
        };


        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans
            >;
        };


        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans
            >;
        };


        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans
            >;
        };
    };
};
