#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// hjkl 用 mod-morph: alt 押下中は alt+矢印(alt は keep-mods で残す)
#define ARROW_MORPH(name, tap, arrow)          \
    name##_morph: name##_morph {               \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>;                  \
        bindings = <tap>, <&kp arrow>;         \
        mods = <(MOD_LALT)>;                   \
        keep-mods = <(MOD_LALT)>;              \
    };

&mt {
    flavor = "hold-preferred";
    quick-tap-ms = <0>;
    retro-tap;
    retro-tap-timeout-ms = <800>;
};

&lt {
    // デフォルトの tap-preferred だと tapping-term(200ms)保持しない限り
    // 必ず tap になり、高速な SPACE→クリック等が SPACE+キー化する。
    // balanced なら「保持中に他キーが押して離された」時点で即 hold 確定する。
    // ただし文字キー上の &lt 2 L は balanced だとロール誤爆するため
    // tap-preferred の &lt_l に退避している
    flavor = "balanced";
    retro-tap;
    retro-tap-timeout-ms = <2000>;
};

/ {
    behaviors {
        // q を 2 回タップで ESC
        td_q: td_q {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp Q>, <&kp ESC>;
        };

        // 修飾キー押下中は tap-dance を経由せず即 Q を出す。
        // tap-dance は upstroke で確定しないため、Cmd+Q で Cmd を先に離すと mod が落ちる
        q_morph: q_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&td_q>, <&kp Q>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
        };

        // z を 2 回タップで大文字 Z
        td_z: td_z {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp Z>, <&kp LS(Z)>;
        };

        // z: hold で shift、double tap で Z
        z_ht: z_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <1>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&td_z>;
        };

        // hjkl morph into alt+arrows while ALT is held.
        ARROW_MORPH(h, &kp H,   LEFT)
        ARROW_MORPH(j, &kp J,   DOWN)
        ARROW_MORPH(k, &kp K,   UP)
        ARROW_MORPH(l, &lt_l 2 L, RIGHT)

        // L(文字キー)専用の layer-tap。グローバル &lt は balanced だが、
        // L だと "walk"/"self" 等の内側ロールで layer 2 (Arrow) に誤爆して
        // 矢印が出るため、L だけ tap-preferred を維持する
        lt_l: lt_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            retro-tap;
            retro-tap-timeout-ms = <2000>;
        };

        // ENTER, but while LALT is held it morphs into SPACE
        // so &kp LALT + this key -> ⌥Space
        enter_morph: enter_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&lt 1 ENTER>, <&kp SPACE>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        // BT_SEL 0 と 1 を1キーでトグル
        bt_toggle: bt_toggle {
            compatible = "cline46,behavior-bt-toggle";
            #binding-cells = <0>;
            profile-a = <0>;
            profile-b = <1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // K + L -> backspace
        combo_backspace {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp BACKSPACE>;
            layers = <0 1 2>;
        };

        // K + L while holding &mo 3 (Fn layer) -> delete
        combo_delete {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp DELETE>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB     &q_morph  &kp W   &kp E   &kp R     &kp T                                      &kp Y        &kp U     &kp I      &kp O      &kp P      &none
&kp LCTRL   &kp A  &kp S   &kp D   &kp F     &kp G                                      &h_morph     &j_morph  &k_morph   &l_morph   &kp SEMI   &none
&kp LSHIFT  &z_ht LSHIFT  &kp X   &kp C   &kp V     &kp B                                      &kp N        &kp M     &kp COMMA  &kp DOT    &kp SLASH  &none
            &mo 3  &none   &none   &kp LALT  &mt LGUI LANG2  &lt 1 SPACE  &enter_morph  &lt 2 LANG1            &kp MINUS  &kp EQUAL
            >;
        };


        layer_1 {
            display-name = "Num";
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4     &kp N5                             &kp N6    &kp N7          &kp N8        &kp N9    &kp N0    &trans
&trans     &kp N4  &kp N5  &kp N6  &mkp LCLK  &mkp RCLK                          &trans    &kp N4          &kp N5        &kp N6    &kp SQT   &trans
&trans     &kp N7  &kp N8  &kp N9  &kp LBKT   &kp RBKT                           &kp N0    &kp N1          &kp N2        &kp N3    &kp BSLH  &trans
           &trans  &kp N0  &trans  &trans     &trans     &kp LSHIFT  &kp RSHIFT  &trans                                  &trans    &trans
            >;
        };


        // trackball はこのレイヤーで scroll になる(CLine46_R.overlay の scroller)。
        layer_2 {
            display-name = "Arrow";
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans                        &trans    &trans    &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK                     &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans     &trans
&trans  &trans  &trans  &trans  &trans     &trans                        &trans    &trans    &trans  &trans     &trans     &trans
        &trans  &trans  &trans  &trans     &trans      &trans    &trans  &trans                          &trans     &trans
            >;
        };


        layer_3 {
            display-name = "Fn";
            bindings = <
&trans         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt_toggle                    &bt BT_CLR  &trans   &trans   &trans   &kp F17  &trans
&trans         &trans        &trans        &kp F19       &trans        &trans                        &kp F13     &kp F14  &kp F15  &kp F16  &trans   &trans
&kp LS(GLOBE)  &trans        &trans        &trans        &trans        &trans                        &kp F18     &trans   &trans   &trans   &trans   &trans
               &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans                        &trans   &trans
            >;
        };


        // unused layer (layer_4, 5 are available)
        /*
        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans
            >;
        };
        */
    };
};
