#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    macros {
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
            label = "LAYER_MOD";
        };
    };

    combos {
        compatible = "zmk,combos";

        // LALT + ENTER -> alt+space
        combo_alt_space {
            timeout-ms = <50>;
            key-positions = <39 42>;
            bindings = <&kp LA(SPACE)>;
            layers = <0>;
        };

        // K + L -> backspace
        combo_backspace {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp BACKSPACE>;
            layers = <0>;
        };

        // K + L while holding &mo 3 (SCROLL layer) -> delete
        combo_delete {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp DELETE>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB     &kp Q  &kp W   &kp E   &kp R     &kp T                                  &kp Y          &kp U       &kp I      &kp O        &kp P      &kp BACKSPACE
&kp LCTRL   &kp A  &kp S   &kp D   &kp F     &kp G                                  &kp H          &kp J       &kp K      &kp L        &kp SEMI   &lt 3 SINGLE_QUOTE
&kp LSHIFT  &kp Z  &kp X   &kp C   &kp V     &kp B                                  &kp N          &kp M       &kp COMMA  &kp DOT      &kp SLASH  &none
            &mo 3  &trans  &trans  &kp LALT  &mt LGUI INT2  &lt 2 SPACE  &kp ENTER  &mt LGUI INT1                         &kp MINUS    &kp EQUAL
            >;
        };


        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans
            >;
        };


        layer_2 {
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N4                    &kp N6    &kp N7     &kp N8     &kp N9  &kp N0  &kp BSLH
&trans     &trans  &trans  &trans  &trans  &kp LBKT                  &kp RBKT  &mkp LCLK  &mkp RCLK  &trans  &trans  &mo 3
&trans     &trans  &trans  &trans  &trans  &kp LPAR                  &kp RPAR  &trans     &trans     &trans  &trans  &trans
           &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans                          &trans  &trans
            >;
        };


        layer_3 {
            bindings = <
&kp ESC  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &trans                  &trans   &trans   &trans   &trans   &kp F17  &studio_unlock
&trans   &trans  &trans  &kp F19       &trans        &trans                  &kp F13  &kp F14  &kp F15  &kp F16  &trans   &trans
&trans   &trans  &trans  &trans        &trans        &trans                  &kp F18  &trans   &trans   &trans   &trans   &trans
         &trans  &trans  &trans        &trans        &trans  &trans  &trans  &trans                     &trans   &trans
            >;
        };


        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans
            >;
        };


        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans
            >;
        };


        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans
            >;
        };
    };
};
